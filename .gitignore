# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pipeline staging — drafts the generator is still writing. Promoted into
# content/ko/ only after validate + verify:quotes pass.
/content/ko/.staging/

# cloudflare / opennext build output
/.open-next/
.wrangler/

# generated from content/ko/*.yaml at build time
/lib/ko/content.generated.ts

# a private deployment's own config: database ids, domain, organisation
wrangler.private.jsonc
