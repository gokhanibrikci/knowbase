{
  // A private knowbase for one organisation, deployed into that organisation's own
  // Cloudflare account. Copy to wrangler.private.jsonc (git-ignored), fill in the
  // placeholders, create the resources, then:
  //
  //   npx wrangler d1 create knowbase-private          → paste database_id below FIRST
  //   npx wrangler d1 migrations apply knowbase-private --remote --config wrangler.private.jsonc
  //   npx wrangler vectorize create knowbase-private-semantic --dimensions=1024 --metric=cosine
  //   npx wrangler vectorize create-metadata-index knowbase-private-semantic --property-name=type --type=string
  //   npm run cf:deploy:private
  //
  //   npx wrangler secret put KNOWBASE_ENROL --config wrangler.private.jsonc
  //
  // KNOWBASE_ENROL is the one token that lets a developer claim a handle here; without it
  // the deployment issues none. Distribute it the way you distribute any build secret:
  //   KNOWBASE_ENROL=<token> KNOWBASE_BASE=https://knowbase.example.internal \
  //     node ~/.knowbase.mjs --connect --with-hook
  //
  // PRIVATE_SITE is left unset on purpose: the browsable pages are 404 until you put
  // Cloudflare Access (or any OIDC) in front of the hostname and then set it to "1". The
  // machine surfaces — /experience.json, /mcp, /stats.json, /p/<id>.md — stay reachable
  // and check the organisation's secret themselves, which is what the hooks and CI use.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowbase-private",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  // run_worker_first is what makes the gate real. Without it Cloudflare serves a matching
  // static file — a prerendered page, the discovery files, the licence — straight off the
  // asset binding, and proxy.ts never runs. On an internal deployment the extra invocation
  // per asset costs nothing worth counting.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "knowbase.example.internal", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "PRIVATE": "1",
    "KNOWBASE_ORG": "Example Ltd",
    "NEXT_PUBLIC_SITE_URL": "https://knowbase.example.internal"
    // "PRIVATE_SITE": "1"   ← only once an identity proxy stands in front of the hostname
  },
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "SEMANTIC", "index_name": "knowbase-private-semantic" }],
  "d1_databases": [
    {
      "binding": "STORE_DB",
      "database_name": "knowbase-private",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "QUERY_LOG", "dataset": "knowbase_private_queries" },
    { "binding": "REPORT_LOG", "dataset": "knowbase_private_reports" }
  ]
}
